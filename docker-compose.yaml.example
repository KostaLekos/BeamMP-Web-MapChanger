services:
  nginx:
    image: nginx:alpine
    container_name: beam-map-nginx
    ports:
      - "30201:80"
    volumes:
      - /path/to/BeamMP-Web-MapChanger/html:/usr/share/nginx/html:ro
      - /path/to/BeamMP-Web-MapChanger/nginx.conf:/etc/nginx/conf.d/default.conf:ro
    depends_on:
      - node
    restart: unless-stopped

  node:
    build: /path/to/BeamMP-Web-MapChanger
    container_name: beam-map-node
    volumes:
      - /path/to/BeamMP-Web-MapChanger/html:/app/html
      - /path/to/BeamMP-Web-MapChanger/backend:/app/backend
      - /path/to/beamng-mp/ServerConfig.toml:/app/backend/ServerConfig.toml
    expose:
      - "30202"
      - "30203"
    restart: unless-stopped

